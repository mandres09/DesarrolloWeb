digraph Gateway {
 graph [rankdir=TB, bgcolor="white", pad=".12", nodesep=".35", ranksep=".62"]
 node [shape=record, fontname=Arial, fontsize=11, style=filled, fillcolor="#faf8f2", color="#555555"]
 edge [fontname=Arial, fontsize=9, color="#555555", arrowsize=.6]
 API [label="{ApiGateway|proxy · controles HTTP\l}"]
 Ruta [label="{RouteDefinition|verbo · patrón · autenticación\l}"]
 Target [label="{ServiceTarget|URL interna · plazo\l}"]
 Auth [label="{AuthenticationPolicy|cookie · sesión revocable\l}"]
 Role [label="{AuthorizationPolicy|rol · propietario · estado\l}"]
 Sec [label="{SecretProvider|resolver identidad · ACL\l}"]
 Gql [label="{GraphQLGateway|ejecutar consulta\l}"]
 Schema [label="{Schema|tipos · campos\l}"]
 Resolver [label="{Resolver|consultar · agrupar\l}"]
 API -> Ruta [dir=back, arrowtail=diamond, taillabel="1", headlabel="1..*"]
 Ruta -> Target [dir=none, taillabel="1..*", headlabel="1"]
 API -> Auth [style=dashed]
 Target -> Role [style=dashed]
 Target -> Sec [style=dashed]
 Target -> Gql [style=dashed]
 Gql -> Schema [dir=none, taillabel="1", headlabel="1"]
 Schema -> Resolver [dir=none, taillabel="1", headlabel="1..*"]
}
